# Configuración del Proyecto DQN CUDA
# Este archivo contiene todas las configuraciones importantes

# ============================================
# CONFIGURACIÓN DE RED
# ============================================

# IP y credenciales del Jetson Xavier
JETSON_IP=172.22.234.49
JETSON_USER=jetson
SSH_KEY=$HOME/.ssh/id_jetson

# Puerto del servidor CUDA
SERVER_PORT=5556

# Directorio remoto en el Jetson
REMOTE_DIR=~/dqn_cuda_project

# ============================================
# CONFIGURACIÓN DE ENTRENAMIENTO
# ============================================

# Número de episodios por defecto
DEFAULT_EPISODES=100

# Dimensiones del entorno
ENV_WIDTH=800
ENV_HEIGHT=600
GRID_SIZE=20

# ============================================
# CONFIGURACIÓN DE DQN
# ============================================

# Tamaño del estado (features del entorno)
STATE_SIZE=15

# Número de acciones posibles
ACTION_SIZE=8

# Arquitectura de la red
HIDDEN_SIZE_1=256
HIDDEN_SIZE_2=128

# Hiperparámetros
LEARNING_RATE=0.0001
GAMMA=0.99
BATCH_SIZE=64
BUFFER_SIZE=100000

# Epsilon (exploración)
EPSILON_START=1.0
EPSILON_END=0.01
EPSILON_DECAY=0.995

# ============================================
# CONFIGURACIÓN DE CUDA
# ============================================

# Arquitectura de GPU (Jetson Xavier)
CUDA_ARCH=sm_72
# Cambiar a sm_87 para Jetson Orin
# Cambiar a sm_86 para RTX 30xx

# ============================================
# ARCHIVOS A DEPLOYAR
# ============================================

CUDA_FILES=(
    "dqn_cuda.cu"
    "dqn_server_cuda.cu"
    "device_query.cu"
    "Makefile"
)

PYTHON_FILES=(
    "client_cuda.py"
    "robot_environment.py"
)

SCRIPT_FILES=(
    "start_server.sh"
)

# ============================================
# NOTAS
# ============================================

# Para usar esta configuración en scripts bash:
# source config.env
# echo $JETSON_IP

# Para Python, leer manualmente o usar python-dotenv:
# pip install python-dotenv
# from dotenv import load_dotenv
# load_dotenv('config.env')
